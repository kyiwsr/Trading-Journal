# Backend settings. Copy to backend/.env for local development.
DATABASE_URL=postgresql+psycopg://journal:journal@localhost:5432/journal
TEST_DATABASE_URL=postgresql+psycopg://journal:journal@localhost:5432/journal_test
ENVIRONMENT=development

# Comma-separated. CORS allowlist, and the Origin required on POST/PUT/PATCH/DELETE.
# In production every entry must be https, and it is the Vercel site the browser loads.
ALLOWED_ORIGIN=http://localhost:5173

# Required (32+ characters) when ENVIRONMENT=production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

COOKIE_NAME=tj_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Failed logins allowed per IP and per email inside the window, before a 429.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
# Proxies that append to X-Forwarded-For before the API. 0 locally; 2 behind Vercel's rewrite and Render.
TRUSTED_PROXY_HOPS=0

# Screenshot storage. Set both or neither.
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=screenshots
UPLOAD_MAX_BYTES=5242880
SIGNED_READ_TTL_SECONDS=3600

# Used only by scripts/seed_user.py
# SEED_EMAIL=
# SEED_PASSWORD=
