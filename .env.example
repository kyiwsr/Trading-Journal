# Backend
DATABASE_URL=postgresql+psycopg://journal:journal@localhost:5432/journal
TEST_DATABASE_URL=postgresql+psycopg://journal:journal@localhost:5432/journal_test
# Comma-separated; CORS allowlist and the Origin required on POST/PUT/PATCH/DELETE
ALLOWED_ORIGIN=http://localhost:5173
ENVIRONMENT=development
# Required (32+ chars) when ENVIRONMENT=production. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Cross-site deploy (Vercel frontend, Render API): COOKIE_SECURE=true and COOKIE_SAMESITE=none
# COOKIE_DOMAIN=

# Used only by scripts/seed_user.py
# SEED_EMAIL=
# SEED_PASSWORD=

# Frontend (frontend/.env)
VITE_API_URL=http://localhost:8000
